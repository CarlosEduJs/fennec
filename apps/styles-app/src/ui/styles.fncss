:root {
    $primary: #0066cc;
    $radius: 20px;
    $spacing: 16px;
    $bg: #f5f5f5;
}

theme dark {
    $primary: #66ccff;
    $bg: #1a1a2e;
}

.container {
    padding: $spacing;
    background: $bg;
    border-radius: $radius;
    width: 100%;
    height: 100%;
}

.title {
    font-size: 24px;
    font-weight: bold;
    color: $primary;
    text-align: center;
}

.card {
    padding: 12px;
    background: white;
    border-radius: $radius;
}
