---
@theme dark
@state StylesState
---

<Styles>
:root {
    $accent: #ff6600;
}
.highlight {
    color: $accent;
    font-weight: bold;
}
</Styles>

<Stack class="container" direction="vertical" gap="16">
    <Text class="title">Styles Demo</Text>
    <Text class="card" style="color: #333; font-size: 14px;">
        Card with class + inline styles
    </Text>
    <Text class="highlight">Token-based color via class</Text>
    <Button class="card" style="background: $accent; color: white; display: flex; justify-content: center; align-items: center; w: 150px; h: 30px" onclick="handle_click">
        Click: {state.count}
    </Button>
</Stack>